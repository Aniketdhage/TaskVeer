{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",

    "moduleResolution": "node",
    "baseUrl": "./src"
  },

  "include": ["src/**/*.ts"],

  "files": ["types/express.d.ts"],

  "exclude": ["node_modules", "dist"]
}
